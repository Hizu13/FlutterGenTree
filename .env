# Copy to .env and edit before running the app
# Use your PC LAN IP (or Tailscale IP) and include the path to the members API.
# Examples:
# API_BASE_URL=http://192.168.1.42:8000/api/flutter/members
# API_BASE_URL=http://10.0.2.2:8000/api/flutter/members  # Android emulator
# API_BASE_URL=https://abcd1234.ngrok.io/api/flutter/members  # ngrok

API_BASE_URL=http://100.109.123.93:8000/api/flutter/members

# MySQL Database Connection (required for backend to create/access tables)
# Format: mysql+pymysql://username:password@host:port/database
# Examples:
# MYSQL_URL=mysql+pymysql://root:yourpassword@127.0.0.1:3306/family_tree_db
# MYSQL_URL=mysql+pymysql://root@127.0.0.1:3306/family_tree_db  (no password)
MYSQL_URL=mysql+pymysql://root:@127.0.0.1:3306/family_tree_db
